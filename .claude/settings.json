{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet format *)",
      "Bash(dotnet run *)",
      "Bash(dotnet list *)",
      "Bash(dotnet --version)",
      "Bash(dotnet --info)",
      "Bash(dotnet ef migrations add *)",
      "Bash(dotnet ef migrations list *)",
      "Bash(dotnet ef migrations script *)",
