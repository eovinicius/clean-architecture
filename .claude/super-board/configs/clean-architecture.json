{
  "version": 1,
  "description": "clean-architecture build pipeline",
  "project": { "owner": "eovinicius", "title": "Clean Architecture Template board", "number": 4 },
  "worker_backend": "workflow",
  "model_tier": "medium",
  "codex": { "model": null },
  "target": { "type": "repo", "url": null },
  "repo": { "path": ".", "remote": "https://github.com/eovinicius/clean-architecture" },
  "base_branch": "development",
  "timezone": "America/Sao_Paulo",
  "columns": ["Backlog", "Ready", "Building", "QA", "Review", "Blocked", "Done"],
  "labels": ["qa", "bug", "feature"],
  "paths": {
    "project_md": "docs/super-board/PROJECT.md",
    "pre_flight_md": "docs/super-board/pre-flight.md",
    "runs_dir": "docs/super-board/runs"
  },
  "human_approves_merge": false,
  "merge_policy": {
    "default": "auto",
    "auto_max_lines": 400,
    "size_exclude": [
      "**/packages.lock.json", "**/Migrations/*.Designer.cs", "**/Migrations/*ModelSnapshot.cs",
      "**/generated/**", "**/*.generated.*", "**/*.g.cs", "**/__snapshots__/**", "**/*.verified.*"
    ],
    "always_human": {
      "money":  { "labels": ["money", "payments", "billing", "pricing"],
                  "paths": ["**/billing/**", "**/payments/**", "**/Billing/**", "**/Payments/**"],
                  "keywords": ["stripe.", "payment_intent", "price_id", "invoice.create"] },
      "auth":   { "labels": ["auth", "security"],
                  "paths": ["**/auth/**", "**/Authentication/**", "**/Authorization/**", "**/Permissions/**"],
                  "keywords": ["[AllowAnonymous]", "HasPermission(", "JwtSecurityToken", "RefreshToken", "PasswordHasher"] },
      "schema": { "labels": ["schema", "destructive"],
                  "paths": [],
                  "keywords": ["DropTable(", "DropColumn(", "RenameColumn(", "RenameTable(", "drop table", "drop column", "truncate table", "rename column", "drop schema"] }
    },
    "allow_auto_on_production": false
  },
  "migrations": {
    "globs": ["app/src/Infrastructure/Database/Migrations/**"],
    "allowed_envs": ["test"],
    "target_env": "test",
    "commands": { "test": "-" },
    "checks": {},
    "human_steps": []
  },
  "no_progress_cycles": 6,
  "max_dispatches": 0,
  "truth_gate": "non-trivial",
  "truth_threshold": 70,
  "usage_pause_pct": 95,
  "usage_fallback": "none",
  "verify_commands": [
    "dotnet build CleanArchitecture.slnx",
    "dotnet format CleanArchitecture.slnx --verify-no-changes --no-restore",
    "dotnet test app/tests/Application.UnitTests --no-build",
    "dotnet test app/tests/ArchitectureTests --no-build"
  ],
  "max_workers": 0,
  "rebuild_cap": 2,
  "block_rate_alert_pct": 30,
  "collect": {
    "sources": ["github", "architecture"],
    "window_days": 14,
    "architecture": { "max_findings": 5 },
    "custom": []
  },
  "notifications": { "channel": "session", "chat_id": null, "bot_identity": "eovinicius" }
}
